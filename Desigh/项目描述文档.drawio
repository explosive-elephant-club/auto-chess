        <mxCell id="1rW8p3E_McQuvrK6oWL6-14" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;部件属性加成列表：&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;&lt;font&gt;排列：按照网格排列，每行最多三个，超过三个新增一行。&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;大小自动适配：根据排列情况自动调整大小，同时也会导致整个单位信息UI大小发生变化。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;" parent="mYbIPjzfmBTcMjQ0SoSB-1" vertex="1">
          <mxGeometry x="4450" y="3320" width="599" height="240" as="geometry" />
