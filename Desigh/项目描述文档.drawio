        <mxCell id="jmI7fHvpwaHkRsgGgDsW-5" value="金币、玩家血量" style="rounded=0;whiteSpace=wrap;html=1;sketch=0;" parent="mYbIPjzfmBTcMjQ0SoSB-1" vertex="1">
