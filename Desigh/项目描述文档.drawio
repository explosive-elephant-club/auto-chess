        <mxCell id="G_GdyL5OR_GU7I4BFcLu-9" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;出售栏:&lt;/font&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;一个专门用来出售部件的区域，拖拽到此处的部件会以50%的价格出售。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="mYbIPjzfmBTcMjQ0SoSB-1" vertex="1">
          <mxGeometry x="6339" y="1230" width="640" height="58.5" as="geometry" />
