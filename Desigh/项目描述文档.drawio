        </mxCell>
        <mxCell id="jmI7fHvpwaHkRsgGgDsW-7" value="关卡信息" style="rounded=0;whiteSpace=wrap;html=1;sketch=0;" parent="mYbIPjzfmBTcMjQ0SoSB-1" vertex="1">
          <mxGeometry x="1170" y="525" width="70" height="25" as="geometry" />
