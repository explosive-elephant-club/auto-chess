          <mxGeometry y="870" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="VqUQp2ivfEWLrcS_l-QB-1" value="&lt;h3 style=&quot;font-size: 20px&quot;&gt;&lt;font style=&quot;font-size: 20px ; font-weight: normal&quot;&gt;部件装配：&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;font-size: 20px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;strong&gt;部件结构&lt;/strong&gt;：&lt;span style=&quot;font-weight: normal;&quot;&gt;所有的&lt;/span&gt;&lt;span style=&quot;font-weight: normal&quot;&gt;部件构成一个树型结构，唯一的底盘部件作为根节点，其他部件作为子节点存储在父节点的槽位中。一个部件可以拥有多个槽位和子节点，但是只有一个父节点。&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;装配：&lt;span style=&quot;font-weight: 400;&quot;&gt;玩家通过从仓库里拖动部件到装配UI中对应的槽位来完成装配步骤，如果槽位不适配部件种类，装配会失败。&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;UI显示：&lt;span style=&quot;font-weight: normal;&quot;&gt;装配UI会按照部件的树型结构显示（如下图所示），子物体通过白线和父物体连接。每个部件会显示子物体和空白的槽位。&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;改进：&lt;font style=&quot;background-color: rgb(255, 255, 0); color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;在&lt;/span&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;装配UI中，是根据部件的坐标来更新其在UI中的位置，在一些角度会导致两个部件UI重叠在一起，需要加入一个重叠后自动排列的方法来解决。&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry width="800" height="390" as="geometry" />
        </mxCell>
        <mxCell id="VqUQp2ivfEWLrcS_l-QB-2" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fillColor=default;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="620" y="800" as="sourcePoint" />
