  <diagram id="nvh_E4VwXdChjpcqglNw" name="技能系统">
    <mxGraphModel dx="2074" dy="1204" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="WKj29tmywDfORu9ggGdK-12" value="" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2620" y="390" width="470" height="100" as="geometry" />
        </mxCell>
        <mxCell id="9GE0gGPVhRGYYvY4BOlH-1" value="&lt;h3 style=&quot;font-size: 20px&quot;&gt;&lt;font style=&quot;font-size: 20px ; font-weight: normal&quot;&gt;技能编辑：&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;font-size: 20px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;strong&gt;激活技能&lt;/strong&gt;：&lt;span style=&quot;font-weight: normal;&quot;&gt;一些的&lt;/span&gt;&lt;span style=&quot;font-weight: normal&quot;&gt;部件会提供技能，这些技能会显示在未激活列表里，玩家可以将其拖动到已激活的列表里来激活它。&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;技能链：&lt;span style=&quot;font-weight: 400;&quot;&gt;激活列表中的技能会根据从左到右的顺序来逐个释放，整个流程是自动的，如果一个技能不符合释放条件，那么它将会被跳过。当&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;激活列表所有技能被释放一遍后，会重新从第一个技能开始。&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;CD：&lt;span style=&quot;font-weight: 400;&quot;&gt;单独一个技能释放后，会需要等待释放CD才能释放下一个技能。当激活列表中的所有技能全部被释放一遍后，&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;会需要等待技能链CD才能重新从第一个技能开始。&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry width="800" height="280" as="geometry" />
        </mxCell>
        <mxCell id="1kt1sikkOqiiq_9z7mj_-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;clipPath=inset(39.35% 83.67% 0.3% 0%);" parent="1" vertex="1">
          <mxGeometry y="280" width="273.82" height="570" as="geometry" />
        </mxCell>
        <mxCell id="sdjUCIVjj-hyP6gS3U0b-1" value="&lt;h3 style=&quot;font-size: 20px&quot;&gt;&lt;font style=&quot;font-size: 20px ; font-weight: normal&quot;&gt;技能释放：&lt;/font&gt;&lt;/h3&gt;&lt;h3 style=&quot;font-size: 20px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;strong&gt;寻找目标&lt;/strong&gt;：&lt;span style=&quot;font-weight: 400;&quot;&gt;会根据配置来寻找对应的目标，目标有可能是：单独一个单位、某个范围内所有的单位、某个坐标点。&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;生效方式：&lt;span style=&quot;font-weight: normal;&quot;&gt;技能可以直接对目标造成伤害和施加buff，也可以生成投射物，并且对投射物绑定伤害和施加buff事件。&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;持续生效：&lt;/font&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;如果技能有多次生效的配置，那么这技能会进入持续施法中，技能CD也会加入这次的持续时间。&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="841" width="800" height="280" as="geometry" />
        </mxCell>
        <mxCell id="sdjUCIVjj-hyP6gS3U0b-2" value="" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
