        <mxCell id="jYjawZ6rC8eqkgr5FQGo-59" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="jYjawZ6rC8eqkgr5FQGo-52" vertex="1">
          <mxGeometry x="70" y="20.5" width="10" height="20" as="geometry" />
        </mxCell>
